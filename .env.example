# Environment variable reference for local development.
# Never place real credentials or personal data in this file.
# Legacy/inactive variables from src/engine are intentionally omitted because
# those modules do not participate in the current /api/analyze decision flow.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Current values: continue | fail
SUPABASE_MISSING_POLICY=continue

# Enrichment / TechTrail
# Current values: off | mock | real. Production must not use mock or off.
ENRICHMENT_MODE=mock
ENRICHMENT_TIMEOUT_MS=4000
ENRICHMENT_URL_BASE=https://apitechtrail.com.br/api/segcelular/pf
ENRICHMENT_AUTH=
ENRICHMENT_MOCK_MS=80
# Current values: APPROVE | DECLINE
ENRICHMENT_FAIL_DECISION=DECLINE

# Used only by scripts/post-test.mjs; not read by the engine.
ANALYZE_URL=http://localhost:3000/api/analyze

# Score
SCORE_EMAIL_DIVERGENTE=0
SCORE_TELEFONE_DIVERGENTE=0
SCORE_CEP_DIVERGENTE=5

SCORE_RISCO_ALTISSIMO=20
SCORE_RISCO_ALTO=15
SCORE_RISCO_MEDIO=5
SCORE_RISCO_BAIXO=0
SCORE_RISCO_BAIXISSIMO=0

SCORE_PROB_ALTISSIMA=0
SCORE_PROB_ALTA=0
SCORE_PROB_MEDIA=5
SCORE_PROB_BAIXA=15
SCORE_PROB_BAIXISSIMA=20

SCORE_PROC_4_5=20
SCORE_PROC_GT_5=25
VALOR_CELULAR_HIGH_VALUE_MIN=5000
SCORE_VALOR_CELULAR_HIGH_VALUE=5

# IMEI
IMEI_INFO_API_KEY=
IMEI_INFO_SERVICE_ID_SAMSUNG=76
IMEI_INFO_SERVICE_ID_APPLE=19
IMEI_INFO_SERVICE_ID_XIAOMI=84
IMEI_TIMEOUT_MS=20000
SCORE_IMEI_PROBLEM=5

# Cache
CACHE_TTL_DAYS_APPROVE=30
CACHE_TTL_DAYS_DECLINE=30
CACHE_TTL_SECONDS_ON_TECH_FAIL=300

# Legacy typo that is still an active compatibility fallback. Prefer the
# correctly spelled CACHE_TTL_DAYS_APPROVE above.
# CACHE_TTL_DAYS_APROVE=30
